<h1>Add a new item</h1>

<form action="/make_a_new_item" method="post">
  <div>
    <label for="zebra">Link URL</label>
    <input id="zebra" type="type" name="link_url_param">
  </div>

  <div>
    <label for="lion">Link Description</label>
    <input id="lion" type="type" name="link_description_param">
  </div>

  <div>
    <label for="cat">Thumbnail URL</label>
    <input id="cat" type="type" name="thumbnail_url_param">
  </div>

  <button>Create item</button>
 
</form>
